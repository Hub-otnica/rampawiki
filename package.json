{
  "name": "rampa-makerspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:knowledge": "node scripts/prepare-knowledge-wiki.mjs",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "build:wiki": "node scripts/build-wiki-site.mjs",
    "dev:knowledge": "npm run prepare:knowledge && npm --prefix wiki run quartz -- build --serve --port 8081",
    "dev:all": "node scripts/dev-all.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:knowledge && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
